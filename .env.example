# Copy to `.env` (or `.env.local`) and fill in. Only EXPO_PUBLIC_* keys are
# exposed to the app bundle — never put secrets here.
#
# Expected keys:
#   EXPO_PUBLIC_API_URL              Base URL of the Hono backend (hc client + R2 presign)
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID Google OAuth *Web* client ID — becomes the ID token
#                                    audience; must equal the backend's GOOGLE_CLIENT_ID.
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID Google OAuth *iOS* client ID (iOS builds only).

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_USE_MOCK=mock
